generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// user
model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  fullName            String
  phone               String?
  country             String?
  emailVerified       DateTime?
  referralCode        String    @unique
  referredBy          String?
  referralBonusPaid   Boolean   @default(false)
  avatarUrl           String?
  role                Role      @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  kycStatus           KycStatus @default(NONE )
  notifyWithdrawal    Boolean   @default(true)
  notifyProfit        Boolean   @default(true)
  notifyPlanExpiry    Boolean   @default(true)

  sessions             Session[]
  verificationToken    VerificationToken[]
  ledger               Ledger[]
  deposits             Deposit[]
  withdrawals          Withdrawal[]
  userPlans            UserPlan[]
  kycSubmissions       KycSubmission[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

// verify
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ledger
enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  PROFIT
  INVESTMENT
  PRINCIPAL_RETURN
  BONUS
  REFERRAL_BONUS
  ADJUSTMENT
}

model Ledger {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int        // integer cents, positive credit, negative debit
  type        LedgerType
  referenceId String?    // links to the deposit/withdrawal/plan that caused it
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([userId, type])
}

// deposits
enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deposit {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int           // integer cents
  coin       String        // "Bitcoin", "USDT (TRC20)", etc.
  proofUrl   String        // R2 URL of the payment screenshot
  status     DepositStatus @default(PENDING)
  reviewedBy String?       // admin user id, set on approve/reject
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
}

// wallet addresses
model WalletAddress {
  id        String   @id @default(cuid())
  coin      String   @unique   // "Bitcoin", "Ethereum", "USDT (TRC20)"
  network   String              // "BTC", "ERC20", "TRC20"
  address   String
  minCents  Int                 // minimum deposit for this coin
  updatedAt DateTime @updatedAt
}

// admin deposit
enum AuditAction {
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  KYC_APPROVED
  KYC_REJECTED
}

model AuditLog {
  id        String      @id @default(cuid())
  adminId   String
  action    AuditAction
  targetId  String      // the deposit/withdrawal/kyc id acted on
  createdAt DateTime    @default(now())

  @@index([adminId])
  @@index([targetId])
}

// withdrawal
enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  coin       String
  address    String
  status     WithdrawalStatus @default(PENDING)
  reviewedBy String?
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
}

// invesment plan
model Plan {
  id           String   @id @default(cuid())
  name         String   @unique      // "Asset 1"
  minCents     Int
  maxCents     Int?                   // null = unlimited
  dailyRatePct Float                  // 1.2 means 1.2% per day
  durationDays Int
  referralPct  Float    @default(5)
  active       Boolean  @default(true) // admin can retire a plan
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

//  user plan - the active investment the cron pays out
enum UserPlanStatus {
  ACTIVE
  COMPLETED
}

model UserPlan {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String
  planName            String         // snapshot of the name at purchase time
  investedCents       Int            // the principal
  dailyRatePct        Float          // snapshot of the rate at purchase time
  accruedProfitCents  Int             @default(0)
  durationDays        Int            // snapshot of the term
  daysPaid            Int             @default(0)   // how many daily profits credited so far
  lastPaidAt          DateTime?
  status              UserPlanStatus @default(ACTIVE)
  startedAt           DateTime       @default(now())
  completedAt         DateTime?

  @@index([userId])
  @@index([status])
}

// kyc
enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model KycSubmission {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType     String    // 'national_id' | 'passport' | 'drivers_license'
  documentFrontUrl String    // R2 key
  documentBackUrl  String?   // nullable — passports have no back
  dateOfBirth      String    // stored as submitted
  addressLine      String
  city             String
  state            String
  country          String
  status           KycStatus @default(PENDING)
  reviewedBy       String?
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  @@index([userId])
  @@index([status])
}

// notification
enum NotificationType {
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_INITIATED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  KYC_APPROVED
  KYC_REJECTED
  PROFIT_EARNED
  PLAN_COMPLETED
  WELCOME
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

// password reset
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}