generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// user
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  fullName      String
  phone         String?
  country       String?
  emailVerified DateTime?
  role          Role       @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  kycStatus     KycStatus  @default(NONE )

  sessions            Session[]
  verificationToken   VerificationToken[]
  ledger              Ledger[]
  deposits            Deposit[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

// verify
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ledger
enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  PROFIT
  INVESTMENT
  BONUS
  REFERRAL_BONUS
  ADJUSTMENT
}

model Ledger {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int        // integer cents, positive credit, negative debit
  type        LedgerType
  referenceId String?    // links to the deposit/withdrawal/plan that caused it
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([userId, type])
}

// deposits
enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deposit {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int           // integer cents
  coin       String        // "Bitcoin", "USDT (TRC20)", etc.
  proofUrl   String        // R2 URL of the payment screenshot
  status     DepositStatus @default(PENDING)
  reviewedBy String?       // admin user id, set on approve/reject
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?

  @@index([userId])
  @@index([status])
}

// wallet addresses
model WalletAddress {
  id        String   @id @default(cuid())
  coin      String   @unique   // "Bitcoin", "Ethereum", "USDT (TRC20)"
  network   String              // "BTC", "ERC20", "TRC20"
  address   String
  minCents  Int                 // minimum deposit for this coin
  updatedAt DateTime @updatedAt
}

// admin deposit
enum AuditAction {
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  KYC_APPROVED
  KYC_REJECTED
}

model AuditLog {
  id        String      @id @default(cuid())
  adminId   String
  action    AuditAction
  targetId  String      // the deposit/withdrawal/kyc id acted on
  createdAt DateTime    @default(now())

  @@index([adminId])
  @@index([targetId])
}